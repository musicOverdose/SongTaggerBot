# MusicOverdose Audio Metadata Editor Bot Configuration
# Bot Telegram Token obtained from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_01234567

# Comma-separated list of Telegram User IDs who have administrative privileges
ADMIN_IDS=123456789

# File size limits in megabytes
# Standard Telegram Bot API limit is 20MB download, 50MB upload.
# If using a Local Bot API server, these can be increased up to 2000MB.
MAX_INPUT_MB=20
MAX_OUTPUT_MB=50

# Concurrency and job lifetime
MAX_CONCURRENT_JOBS=2
JOB_TTL_MINUTES=30

# File storage locations
DATA_DIR=/data
TEMP_DIR=/tmp/audio-bot

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Feature toggles & formatting
SHOW_TECHNICAL_INFO=true
SEND_COVER_SEPARATELY=false
DEFAULT_FILENAME_FORMAT={track:02} - {title}

# Telegram API base URLs (override when using Local Bot API Server)
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_FILE_BASE=https://api.telegram.org/file
