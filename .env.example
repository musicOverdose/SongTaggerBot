# SongTaggerBot Audio Metadata Editor Bot Configuration
# Bot Telegram Token obtained from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_01234567

# Comma-separated list of Telegram User IDs who have administrative privileges
ADMIN_IDS=123456789

# ==============================================================================
# Telegram Bot API Mode (Dual Mode: Cloud vs Centralized Local Server)
# ==============================================================================
# Cloud Mode (default): connects to official Telegram servers (https://api.telegram.org)
# Local Mode: connects to our centralized, shared Local Bot API server
TELEGRAM_API_MODE=cloud
TELEGRAM_API_BASE_URL=https://api.telegram.org

# To connect to the shared centralized Local Bot API stack on the VPS:
# TELEGRAM_API_MODE=local
# TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081
# Note: Credentials (API_ID / API_HASH) belong exclusively to the centralized
# server stack and are NOT required by this bot.

# File size limits in megabytes
# Standard Telegram Bot API limit is 20MB download, 50MB upload (Cloud Mode).
# When using Local Mode (centralized server), these can be increased up to 2000MB.
MAX_INPUT_MB=20
MAX_OUTPUT_MB=50

# Concurrency and job lifetime
MAX_CONCURRENT_JOBS=2
MAX_USER_CONCURRENT_JOBS=1
MAX_GLOBAL_CONCURRENT_JOBS=10
RATE_LIMIT_UPLOADS_PER_MINUTE=5
JOB_TTL_MINUTES=30
FFMPEG_TIMEOUT_SECONDS=120
FFPROBE_TIMEOUT_SECONDS=30
BACKUP_RETENTION_DAYS=7

# File storage locations
DATA_DIR=/data
TEMP_DIR=/tmp/audio-bot

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Feature toggles & formatting
SHOW_TECHNICAL_INFO=true
SEND_COVER_SEPARATELY=false
DEFAULT_FILENAME_FORMAT={track:02} - {title}
